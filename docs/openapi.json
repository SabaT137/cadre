                },
                "type": "object",
                "required": [
                    "file"
                ],
                "title": "Body_upload_template_templates_post"
            },
            "ChatRequest": {
                "properties": {
                    "message": {
                        "type": "string",
                        "maxLength": 20000,
                        "minLength": 1,
                        "title": "Message"
                    },
                    "thread_id": {
                        "anyOf": [
                            {
                                "type": "string"
                            },
                            {
                                "type": "null"
                            }
                        ],
                        "title": "Thread Id"
                    },
                    "department": {
                        "type": "string",
                        "enum": [
                            "auto",
                            "hr",
                            "devops",
                            "finance",
                            "pm",
                            "developer"
                        ],
                        "title": "Department",
                        "default": "auto"
                    },
                    "template_id": {
                        "anyOf": [
                            {
                                "type": "string"
                            },
                            {
                                "type": "null"
                            }
                        ],
                        "title": "Template Id"
                    }
                },
                "type": "object",
                "required": [
                    "message"
                ],
                "title": "ChatRequest"
            },
            "ChatResponse": {
                "properties": {
                    "thread_id": {
                        "type": "string",
                        "title": "Thread Id"
