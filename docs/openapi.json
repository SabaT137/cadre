    "components": {
        "schemas": {
            "AgentPatch": {
                "properties": {
                    "enabled": {
                        "type": "boolean",
                        "title": "Enabled"
                    }
                },
                "type": "object",
                "required": [
                    "enabled"
                ],
                "title": "AgentPatch"
            },
            "Body_upload_template_templates_post": {
                "properties": {
                    "file": {
                        "type": "string",
                        "contentMediaType": "application/octet-stream",
                        "title": "File"
                    },
                    "name": {
                        "anyOf": [
                            {
                                "type": "string"
                            },
                            {
                                "type": "null"
                            }
                        ],
                        "title": "Name"
                    },
                    "description": {
                        "type": "string",
                        "title": "Description",
                        "default": ""
