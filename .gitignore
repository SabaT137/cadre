# ─────────────────────────────────────────────────────────────
# Secrets — NEVER commit. Copy .env.example → .env locally.
# ─────────────────────────────────────────────────────────────
.env
.env.*
!.env.example
web/.env*
!web/.env.example
*.pem
*.key

# ─────────────────────────────────────────────────────────────
# Runtime data (users, conversations, encrypted Jira tokens, demo DB)
# ─────────────────────────────────────────────────────────────
data/
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# Generated documents (contracts/invoices contain personal data: CNICs, addresses)
storage/outputs/

# User-uploaded contract templates — keep only the bundled one
storage/templates/*
!storage/templates/consultant_hourly_parttime.docx
!storage/templates/consultant_hourly_parttime.json

# CEO's scanned signature (extracted from the sample invoice) — keep out of the repo
storage/invoice_assets/signature.png

# ─────────────────────────────────────────────────────────────
# Python
# ─────────────────────────────────────────────────────────────
.venv/
venv/
env/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# ─────────────────────────────────────────────────────────────
# Next.js frontend (web/)
# ─────────────────────────────────────────────────────────────
web/node_modules/
web/.next/
web/out/
web/build/
web/coverage/
web/next-env.d.ts
web/*.tsbuildinfo
web/.vercel
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ─────────────────────────────────────────────────────────────
# Editors, OS, local tooling
# ─────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.log
# Local Claude Code permissions (may contain machine-specific commands)
.claude/settings.local.json
