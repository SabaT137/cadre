LLM_BASE_URL=https://your-gateway.example.com/v1

SUPERVISOR_MODEL=glm-5.2
SUPERVISOR_API_KEY=sk-...

WORKER_MODEL=qwen3.5
WORKER_API_KEY=sk-...
# Set to true only if the gateway supports native tool calling for the worker model
WORKER_NATIVE_TOOLS=false

DEVOPS_DATABASE_URL=sqlite:///data/devops.db

# Auth: long random string (python -c "import secrets;print(secrets.token_urlsafe(48))")
APP_SECRET_KEY=change-me
# First admin, created on first start if no admin exists
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# Optional dev shortcut: API-token Jira connection attached to the admin user on first start
JIRA_BOOTSTRAP_SITE=https://yourcompany.atlassian.net
JIRA_BOOTSTRAP_EMAIL=
JIRA_BOOTSTRAP_API_TOKEN=

# Jira OAuth 2.0 (3LO) "Connect Jira" button – from developer.atlassian.com
JIRA_OAUTH_CLIENT_ID=
JIRA_OAUTH_CLIENT_SECRET=
JIRA_OAUTH_REDIRECT_URI=http://localhost:8000/integrations/jira/callback
USER_UI_URL=http://localhost:3000/settings

# Streamlit -> FastAPI
API_BASE_URL=http://localhost:8000
